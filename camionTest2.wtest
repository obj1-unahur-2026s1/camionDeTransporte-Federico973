import cosas2.*
import camion2.*
import camion.*
import cosas.*

describe "Test paquete, bateria, contenedor y embalaje" {
  
  method initialize(){
    residuos.peso(30)
    embalaje.cambiarCosaEnvuelta(residuos)
    contenedor.meterElementos([embalaje, residuos, bumblebee])
    bumblebee.cambiarForma(robot)
    arena.peso(150)
    bateria.estadoActual()
    paqueteDeLadrillos.cambiarCantidad(80)
    embalaje.cambiarCosaEnvuelta(paqueteDeLadrillos)
    //camion.cargarCosas([bumblebee, bateria, embalaje, arena])
    camion.cargarCosa(bumblebee)
    camion.cargarCosa(bateria)
    camion.cargarCosa(embalaje)
    camion.cargarCosa(arena)
  }

  test "test1" {
    residuos.peso(30)
    embalaje.cambiarCosaEnvuelta(residuos)
    contenedor.meterElementos([embalaje, residuos, bumblebee])
    assert.equals(960, contenedor.peso())
  }
  test "test peso"{
    assert.equals(1000+800+160+140+300, camion.peso())
  }
  test "tets pesos pares"{
    assert.that(camion.todosLosPesosSonPares())
  }
  test "cantidad Total de Bultos cargardos en el camion es de"{
    assert.equals(2+2+1+2, camion.cantidadTotalDeBultos())
  }
}